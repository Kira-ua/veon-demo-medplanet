---
import "@fontsource-variable/geologica/wght.css";
import "@fontsource/manrope/400.css";
import "@fontsource/manrope/700.css";
import geologicaCyr from "@fontsource-variable/geologica/files/geologica-cyrillic-wght-normal.woff2?url";
import "../styles/tokens.css";
import "../styles/global.css";
import "../styles/ui.css";

interface Props { lang: string; title: string; description: string; canonical?: string; ogImage?: string; }
const { lang, title, description, canonical, ogImage } = Astro.props;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <script is:inline>document.documentElement.classList.add("js")</script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="preload" href={geologicaCyr} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="data:," />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="uk_UA" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="robots" content="noindex" />
    <slot name="head" />
    <style is:global>html, body { overflow-x: clip; }</style>
  </head>
  <body id="top">
    <a class="skip-link" href="#main">{lang.startsWith("uk") ? "До змісту" : lang.startsWith("ru") ? "К содержанию" : "Skip to content"}</a>
    <slot name="header" />
    <main id="main"><slot /></main>
    <slot name="footer" />
    <slot name="after" />
    <script src="../scripts/home.ts"></script>
  </body>
</html>
