---
import { Picture } from "astro:assets";
import FutureLink from "./FutureLink.astro";
import Icon from "./Icon.astro";
import { contact, products, formatPrice, FUTURE } from "../data/site";
---
<section id="products" class="prods section">
  <div class="container">
    <div class="section__head prods__head">
      <h2>Ціни на популярні позиції</h2>
      <p class="section__lead">Ціни на 20.11.2026, актуальні уточнюйте у менеджера.</p>
    </div>

    <div class="prods__scroll" role="region" aria-label="Товари з цінами" tabindex="0">
      <ol class="prods__list">
        {products.map((p) => (
          <li class="prod">
            <div class:list={["prod__photo", p.fill && "prod__photo--fill"]}>
              <Picture fallbackFormat="jpg" quality={80} src={p.photo} formats={["avif", "webp"]} widths={[280, 420, 640]} sizes="(min-width: 1024px) 300px, 70vw" alt={p.name} loading="lazy" decoding="async" />
            </div>
            <h3 class="prod__name">{p.name}</h3>
            <p class="prod__code code">Код {p.code}</p>
            <p class="prod__price">
              <span class="visually-hidden">Ціна: </span><span class="price">{formatPrice(p.price)}</span>
              {p.oldPrice && <s class="prod__old price"><span class="visually-hidden">Стара ціна: </span>{formatPrice(p.oldPrice)}</s>}
            </p>
            <div class="prod__actions">
              <a class="btn btn--primary btn--sm" href={contact.viber}><Icon name="viber" />Замовити у Viber</a>
              <FutureLink note={FUTURE}>Детальніше</FutureLink>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<style>
  .prods__scroll { position: relative; overflow-x: auto; overscroll-behavior-x: contain; scroll-snap-type: x mandatory; margin-inline: calc(-1 * var(--gutter)); padding-inline: var(--gutter); scroll-padding-inline: var(--gutter); padding-bottom: var(--s-2); }
  .prods__list { list-style: none; display: grid; grid-auto-flow: column; grid-auto-columns: 74%; gap: var(--s-3); }
  .prod { position: relative; scroll-snap-align: start; display: grid; grid-template-rows: auto auto auto auto 1fr; align-content: start; gap: var(--s-1); min-width: 0; }
  .prod__photo { background: var(--color-cell); aspect-ratio: 1 / 1; padding: var(--s-2); border-radius: var(--radius); margin-bottom: var(--s-1); }
  .prod__photo :global(picture), .prod__photo :global(img) { display: block; width: 100%; height: 100%; object-fit: contain; }
  .prod__photo--fill { padding: 0; overflow: hidden; }
  .prod__photo--fill :global(img) { object-fit: cover; }
  .prod__name { font-size: var(--fs-body); line-height: 1.4; }
  .prod__code { font-size: var(--fs-meta); color: var(--color-muted); }
  .prod__price { display: flex; align-items: baseline; flex-wrap: wrap; gap: 0 var(--s-2); }
  .prod__price .price:first-child { font-family: var(--font-display); font-weight: 700; font-size: var(--fs-price); line-height: 1.2; color: var(--color-text); }
  .prod__old { color: var(--color-muted); font-size: var(--fs-meta); }
  .prod__actions { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s-1) var(--s-3); align-self: end; padding-top: var(--s-1); }

  @media (min-width: 768px) {
    .prods__list { grid-auto-columns: 42%; }
  }
  @media (min-width: 1024px) {
    .prods__scroll { overflow: visible; margin-inline: 0; padding-inline: 0; padding-bottom: 0; }
    .prods__list { grid-auto-flow: row; grid-template-columns: repeat(4, minmax(0, 1fr)); grid-template-rows: repeat(5, auto); column-gap: var(--s-5); row-gap: var(--s-1); }
    .prod { grid-row: span 5; grid-template-rows: subgrid; gap: inherit; position: relative; }
    .prod + .prod::before { content: ""; position: absolute; top: 0; bottom: 0; left: calc(var(--s-5) / -2); width: 1px; background: var(--color-rule); }
  }
</style>
