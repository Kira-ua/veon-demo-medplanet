---
// One line icon set (stroke 1.75, currentColor, no circle backgrounds). Decorative: the control carries the text.
type Name = "phone" | "viber" | "telegram" | "mail" | "menu" | "close" | "arrow" | "chevron" | "copy";
interface Props { name: Name; class?: string; }
const { name, class: cls } = Astro.props;
---
<svg class:list={["icon", cls]} viewBox="0 0 24 24" aria-hidden="true" focusable="false">
  {name === "phone" && <path d="M5 3.5h3.2l1.6 4.2-2 1.3a11 11 0 0 0 7.2 7.2l1.3-2 4.2 1.6V19a1.6 1.6 0 0 1-1.7 1.6A16.5 16.5 0 0 1 3.4 5.2 1.6 1.6 0 0 1 5 3.5Z" />}
  {name === "viber" && <>
    <path d="M12 2.8c5 0 8.4 1.7 8.4 8 0 6.2-3.4 7.9-8.4 7.9-.8 0-1.6 0-2.3-.1L6.4 21v-3.2C4.3 16.7 3.6 14.6 3.6 10.8c0-6.3 3.4-8 8.4-8Z" />
    <path d="M9.4 7.6c.4 0 .7.2.8.6l.4 1.2c.1.4 0 .7-.3.9l-.4.3c.6 1.3 1.6 2.3 2.9 2.9l.3-.4c.2-.3.6-.4.9-.3l1.2.4c.4.1.6.5.6.8 0 .9-.8 1.6-1.7 1.5-2.8-.4-5.2-2.8-5.6-5.6-.1-.9.6-1.7 1.5-1.7Z" />
    <path d="M13 6.4a3.6 3.6 0 0 1 3.1 3.1" />
  </>}
  {name === "telegram" && <path d="M21 4.2 2.9 11.1c-.8.3-.8 1.4 0 1.6l4.4 1.4 1.7 5.3c.2.6 1 .8 1.5.3l2.5-2.4 4.6 3.4c.6.4 1.4.1 1.6-.6L22.2 5.4c.2-.9-.5-1.5-1.2-1.2ZM7.3 14.1l10-6.3-7.6 7.4-.3 3.3" />}
  {name === "mail" && <><rect x="3" y="5" width="18" height="14" rx="1.5" /><path d="m3.5 6 8.5 7 8.5-7" /></>}
  {name === "menu" && <path d="M4 7h16M4 12h16M4 17h16" />}
  {name === "close" && <path d="M6 6l12 12M18 6 6 18" />}
  {name === "arrow" && <path d="M5 12h14M13 6l6 6-6 6" />}
  {name === "chevron" && <path d="m6 9 6 6 6-6" />}
  {name === "copy" && <><rect x="8" y="8" width="12" height="12" rx="1.5" /><path d="M16 8V5.5A1.5 1.5 0 0 0 14.5 4h-9A1.5 1.5 0 0 0 4 5.5v9A1.5 1.5 0 0 0 5.5 16H8" /></>}
</svg>
