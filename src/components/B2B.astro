---
import FutureLink from "./FutureLink.astro";
import Icon from "./Icon.astro";
import { contact, letter, mailtoHref, FUTURE } from "../data/site";

const steps = [
  { title: "Надішліть перелік і кількість", text: "На e-mail або у Viber: позиції, кількість, місто доставки." },
  { title: "Менеджер підтверджує і виставляє рахунок", text: "З ПДВ або без ПДВ. Кожне замовлення підтверджує менеджер." },
  { title: "Відправка Новою Поштою", text: "По всій Україні, 1–3 дні." },
];
---
<section id="b2b" class="b2b field section" data-rec="R-005">
  <div class="container">
    <div class="section__head b2b__head">
      <h2>Замовлення для організацій: рахунок з ПДВ і Prozorro</h2>
    </div>

    <div class="b2b__grid">
      <ol class="steps">
        {steps.map((s, i) => (
          <li class="step">
            <span class="step__num num" aria-hidden="true">{i + 1}</span>
            <div class="step__body">
              <h3 class="step__title">{s.title}</h3>
              <p class="step__text">{s.text}</p>
            </div>
          </li>
        ))}
      </ol>

      <div class="sheet-wrap">
        <figure class="sheet" aria-labelledby="sheet-cap">
          <figcaption id="sheet-cap" class="sheet__cap">Шаблон листа, який відкриється у вашій пошті</figcaption>
          <dl class="sheet__meta">
            <div><dt>Кому</dt><dd>{contact.email}</dd></div>
            <div><dt>Тема</dt><dd>{letter.subject}</dd></div>
          </dl>
          <dl class="sheet__fields">
            {letter.fields.map((f) => (
              <div class:list={["sheet__row", f.value && "sheet__row--list"]}>
                <dt>{f.label}</dt>
                <dd aria-hidden="true">{f.value ? <ol class="sheet__lines"><li></li><li></li><li></li></ol> : <span class="sheet__line"></span>}</dd>
              </div>
            ))}
          </dl>
        </figure>
        <div class="b2b__actions">
          <a class="btn btn--signal" href={mailtoHref}><Icon name="mail" />Надіслати перелік на e-mail</a>
          <a class="btn btn--line" href={contact.viber}><Icon name="viber" />Написати у Viber</a>
        </div>
      </div>
    </div>

    <dl class="reqs">
      <div><dt>Продавець</dt><dd>{contact.legal}</dd></div>
      <div><dt>ЄДРПОУ</dt><dd class="num">{contact.edrpou}</dd></div>
      <div><dt>Публічні закупівлі</dt><dd>Участь у системі Prozorro</dd></div>
      <div><dt>Постачання</dt><dd>Пряма співпраця з виробниками тактичного медобладнання</dd></div>
      <div><dt>Опт</dt><dd>кнопка «Купити оптом» у картці товару</dd></div>
    </dl>
    <p class="b2b__more"><FutureLink note={FUTURE}>Детальніше для організацій</FutureLink></p>
  </div>
</section>

<style>
  .b2b__head { max-width: 52rem; }
  .b2b__grid { display: grid; gap: var(--s-5); }
  .steps { list-style: none; display: grid; gap: var(--s-4); align-content: start; }
  .step { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: var(--s-3); }
  .step__num { font: 700 var(--fs-h2)/1 var(--font-display); color: var(--color-accent); min-width: 1.2ch; }
  .step__body { display: grid; gap: var(--s-1); padding-top: 0.3em; }
  .step__text { color: var(--color-on-field-muted); }

  /* the list sheet: a letter preview, not a form */
  .sheet-wrap { display: grid; gap: var(--s-3); align-content: start; min-width: 0; }
  .sheet { margin: 0; background: var(--color-bg); color: var(--color-text); border-radius: var(--radius); padding: var(--s-3); display: grid; gap: var(--s-3); --focus: var(--color-primary); }
  .sheet__cap { font-size: var(--fs-meta); color: var(--color-muted); }
  .sheet__meta { display: grid; gap: var(--s-1); padding-bottom: var(--s-2); border-bottom: 1px solid var(--color-rule); margin: 0; }
  .sheet__meta div { display: grid; grid-template-columns: 4.5rem minmax(0, 1fr); gap: var(--s-2); }
  .sheet__meta dt { color: var(--color-muted); font-size: var(--fs-meta); }
  .sheet__meta dd { margin: 0; font-weight: 700; overflow-wrap: anywhere; }
  .sheet__fields { display: grid; gap: var(--s-2); margin: 0; }
  .sheet__row { display: grid; gap: var(--s-1); }
  .sheet__row dt { font-weight: 700; }
  .sheet__row dd { margin: 0; }
  .sheet__line { display: block; height: 1.5rem; border-bottom: 1px solid var(--color-rule); }
  .sheet__lines { margin: 0; padding-left: 1.5rem; color: var(--color-muted); font-variant-numeric: tabular-nums; }
  .sheet__lines li { height: 1.75rem; border-bottom: 1px solid var(--color-rule); }
  .b2b__actions { display: grid; gap: var(--s-2); }

  .reqs { margin: var(--s-5) 0 0; display: grid; gap: var(--s-2); border-top: 1px solid var(--color-rule-field); padding-top: var(--s-3); }
  .reqs div { display: grid; gap: 0.15rem; align-content: start; }
  .reqs dt { font-size: var(--fs-meta); color: var(--color-on-field-muted); }
  .reqs dd { margin: 0; font-weight: 700; }
  .b2b__more { margin-top: var(--s-3); }

  @media (min-width: 768px) {
    .sheet { padding: var(--s-4); }
    .sheet__row { grid-template-columns: 12rem minmax(0, 1fr); align-items: end; }
    .sheet__row--list { align-items: start; }
    .b2b__actions { display: flex; flex-wrap: wrap; }
    .reqs { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--s-3); }
  }
  @media (min-width: 1024px) {
    .b2b__grid { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: var(--s-5); }
    .reqs { grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 0; margin-top: var(--s-6); }
    .reqs div { padding-inline: var(--s-3); border-left: 1px solid var(--color-rule-field); }
    .reqs div:first-child { padding-left: 0; border-left: 0; }
  }
</style>
