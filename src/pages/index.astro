---
import { getImage } from "astro:assets";
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Directions from "../components/Directions.astro";
import Products from "../components/Products.astro";
import B2B from "../components/B2B.astro";
import Delivery from "../components/Delivery.astro";
import Contacts from "../components/Contacts.astro";
import Footer from "../components/Footer.astro";
import MobileDock from "../components/MobileDock.astro";
import { contact, products } from "../data/site";
import ogSrc from "../assets/products/military-maxi-35902.webp";

// SEO-R002: one H1, title ≤ 60, description ≤ 160, og:description and og:image
const title = "Тактичні та цивільні аптечки, медтехніка — Medplanet";
const description = "Тактичні й цивільні аптечки, медичний інструмент, обладнання і меблі. Рахунок з ПДВ і без, Prozorro, доставка Новою Поштою 1–3 дні.";
const og = await getImage({ src: ogSrc, width: 1200, height: 1200, format: "jpg" });

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      name: "Medplanet",
      legalName: contact.legal,
      email: contact.email,
      telephone: contact.phoneE164,
      contactPoint: { "@type": "ContactPoint", telephone: contact.phoneE164, contactType: "sales", availableLanguage: ["uk"] },
    },
    {
      "@type": "ItemList",
      name: "Ціни на популярні позиції",
      itemListElement: products.map((p, i) => ({
        "@type": "ListItem",
        position: i + 1,
        item: {
          "@type": "Product",
          name: p.name,
          sku: p.code,
          offers: { "@type": "Offer", price: p.price, priceCurrency: "UAH" },
        },
      })),
    },
  ],
};
---
<Base lang="uk" title={title} description={description} ogImage={og.src}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} data-rec="SEO-R002" />
  <Header slot="header" />
  <Hero />
  <Directions />
  <Products />
  <B2B />
  <Delivery />
  <Contacts />
  <Footer slot="footer" />
  <MobileDock slot="after" />
</Base>
